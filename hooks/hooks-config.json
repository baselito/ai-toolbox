{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-chief-of-staff.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-auto-poll.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/workflow-auto-approve.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/push-safety.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pr-action-safety.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-transition-script.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-codex-review.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-fable-review.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-pr-skill.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-jira-delegation.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-compliance-audit.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-workflow-start.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-standing-auth.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-skill-delegation.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-loop-bounds.sh"
          }
        ]
      },
      {
        "matcher": "CronCreate",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-loop-bounds.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-ask-budget.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/workflow-auto-approve.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-standing-auth.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/workflow-auto-approve.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-standing-auth.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/audit-model-usage.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/compliance-auditor.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-poll-after-pr.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/consume-pr-markers.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash",
      "Bash(acli jira *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(bd *)",
      "Glob",
      "Read",
      "Write(.claude/**)",
      "Write(~/.claude/**)",
      "Edit(.claude/**)",
      "Edit(~/.claude/**)",
      "Edit(.claude/handover.md)",
      "Write(.claude/handover.md)",
      "mcp__seq__*",
      "mcp__context7__*"
    ],
    "deny": []
  }
}
